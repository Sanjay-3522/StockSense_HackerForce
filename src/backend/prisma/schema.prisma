// StockSense — unified Prisma schema
//
// ONE schema for the whole backend. Foundation models (User, auth,
// ProductCategory, Product, Warehouse, Location, Stock, ReorderRule,
// AdjustmentReason) are owned by Member 1 and are canonical here.
// Operations models (Receipt, Delivery, Transfer, Adjustment,
// StockMovement) are owned by Member 2 and now point at Member 1's
// foundation tables instead of their own placeholder copies.
// IntelligenceAction is owned by Member 3.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTH (Member 1 — canonical, only auth system in the project)
// ============================================================

enum UserRole {
  INVENTORY_MANAGER
  WAREHOUSE_STAFF
}

model User {
  id           String             @id @default(uuid())
  name         String
  email        String             @unique
  passwordHash String             @map("password_hash")
  role         UserRole           @default(INVENTORY_MANAGER)
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  otps         PasswordResetOtp[]

  @@map("users")
}

model PasswordResetOtp {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  expiresAt DateTime @map("expires_at")
  verified  Boolean  @default(false)
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("password_reset_otps")
}

// ============================================================
// PRODUCT CATALOG (Member 1 — canonical)
// ============================================================

model ProductCategory {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  products    Product[]

  @@map("product_categories")
}

model Product {
  id          String   @id @default(uuid())
  name        String
  sku         String   @unique
  description String?
  categoryId  String?  @map("category_id")
  category    ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  unit        String   @default("unit")
  barcode     String?
  isActive    Boolean  @default(true) @map("is_active")
  // Quantity requested at product-creation time. Informational/setup only —
  // actual inventory is always Stock (see productService's transaction,
  // which creates a real Stock row at initialStockLocationId when this is
  // set). Never read this as current on-hand quantity; nothing else in the
  // system does.
  initialStock Int?    @map("initial_stock")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  stocks         Stock[]
  reorderRules   ReorderRule[]
  stockMovements StockMovement[]
  receiptItems   ReceiptItem[]
  deliveryItems  DeliveryItem[]
  transferItems  TransferItem[]
  adjustments    Adjustment[]

  @@map("products")
}

// ============================================================
// WAREHOUSE / LOCATION (Member 1 — canonical)
// ============================================================

model Warehouse {
  id        String     @id @default(uuid())
  code      String     @unique
  name      String
  address   String?
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at")

  locations      Location[]
  reorderRules   ReorderRule[]
  receipts       Receipt[]
  deliveries     Delivery[]
  stockMovements StockMovement[]

  @@map("warehouses")
}

model Location {
  id          String    @id @default(uuid())
  warehouseId String    @map("warehouse_id")
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  code        String
  name        String
  zone        String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")

  stocks       Stock[]
  reorderRules ReorderRule[]

  receiptsAsLocation   Receipt[]  @relation("ReceiptLocation")
  deliveriesAsLocation Delivery[] @relation("DeliveryLocation")

  transfersAsSource      Transfer[] @relation("TransferSource")
  transfersAsDestination Transfer[] @relation("TransferDestination")

  adjustments Adjustment[]

  movementsAsLocation    StockMovement[] @relation("MovementLocation")
  movementsAsSource      StockMovement[] @relation("MovementSource")
  movementsAsDestination StockMovement[] @relation("MovementDestination")

  @@unique([warehouseId, code])
  @@map("locations")
}

// ============================================================
// STOCK (Member 1 owns the model; Member 2's ledgerService is the
// only code path that mutates it — see services/ledgerService.ts)
// ============================================================

model Stock {
  id         String   @id @default(uuid())
  productId  String   @map("product_id")
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  locationId String   @map("location_id")
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  quantity   Int      @default(0)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([productId, locationId])
  @@map("stock")
}

// ============================================================
// REORDER RULES (Member 1 owns the model; Member 3's reorderService
// is the only intelligence code that reads it — recommendation-only,
// never mutates stock or places orders)
// ============================================================

model ReorderRule {
  id          String     @id @default(uuid())
  productId   String     @map("product_id")
  product     Product    @relation(fields: [productId], references: [id])
  warehouseId String?    @map("warehouse_id")
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])
  locationId  String?    @map("location_id")
  location    Location?  @relation(fields: [locationId], references: [id])
  reorderPoint    Int    @map("reorder_point")
  reorderQuantity Int    @map("reorder_quantity")
  maxStock        Int?   @map("max_stock")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([productId, warehouseId, locationId])
  @@map("reorder_rules")
}

// ============================================================
// ADJUSTMENT REASONS (Member 1 owns the model; Member 2's
// adjustmentService consumes it)
// ============================================================

model AdjustmentReason {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  adjustments Adjustment[]

  @@map("adjustment_reasons")
}

// ============================================================
// OPERATIONS (Member 2 — Receipt / Delivery / Transfer / Adjustment /
// StockMovement. Foreign keys now point at Member 1's foundation
// models above instead of Member 2's original standalone copies.)
// ============================================================

enum OperationStatus {
  draft
  waiting
  ready
  done
  canceled
}

model Receipt {
  id           String          @id @default(uuid())
  reference    String          @unique
  supplierName String?         @map("supplier_name")
  warehouseId  String?         @map("warehouse_id")
  locationId   String?         @map("location_id")
  status       OperationStatus @default(draft)
  notes        String?
  createdBy    String?         @map("created_by")
  validatedBy  String?         @map("validated_by")
  validatedAt  DateTime?       @map("validated_at")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @default(now()) @updatedAt @map("updated_at")

  warehouse Warehouse?    @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  location  Location?     @relation("ReceiptLocation", fields: [locationId], references: [id], onDelete: SetNull)
  items     ReceiptItem[]

  @@map("receipts")
}

model ReceiptItem {
  id        String   @id @default(uuid())
  receiptId String   @map("receipt_id")
  productId String   @map("product_id")
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at")

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("receipt_items")
}

model Delivery {
  id           String          @id @default(uuid())
  reference    String          @unique
  customerName String?         @map("customer_name")
  warehouseId  String?         @map("warehouse_id")
  locationId   String?         @map("location_id")
  status       OperationStatus @default(draft)
  notes        String?
  createdBy    String?         @map("created_by")
  validatedBy  String?         @map("validated_by")
  validatedAt  DateTime?       @map("validated_at")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @default(now()) @updatedAt @map("updated_at")

  warehouse Warehouse?     @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  location  Location?      @relation("DeliveryLocation", fields: [locationId], references: [id], onDelete: SetNull)
  items     DeliveryItem[]

  @@map("deliveries")
}

model DeliveryItem {
  id           String @id @default(uuid())
  deliveryId   String @map("delivery_id")
  productId    String @map("product_id")
  requestedQty Int    @map("requested_qty")
  pickedQty    Int    @default(0) @map("picked_qty")
  packedQty    Int    @default(0) @map("packed_qty")

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("delivery_items")
}

model Transfer {
  id                    String          @id @default(uuid())
  reference             String          @unique
  sourceLocationId      String          @map("source_location_id")
  destinationLocationId String          @map("destination_location_id")
  status                OperationStatus @default(draft)
  notes                 String?
  createdBy             String?         @map("created_by")
  validatedBy           String?         @map("validated_by")
  validatedAt           DateTime?       @map("validated_at")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @default(now()) @updatedAt @map("updated_at")

  sourceLocation      Location       @relation("TransferSource", fields: [sourceLocationId], references: [id])
  destinationLocation Location       @relation("TransferDestination", fields: [destinationLocationId], references: [id])
  items               TransferItem[]

  @@map("transfers")
}

model TransferItem {
  id         String @id @default(uuid())
  transferId String @map("transfer_id")
  productId  String @map("product_id")
  quantity   Int

  transfer Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("transfer_items")
}

model Adjustment {
  id          String          @id @default(uuid())
  reference   String          @unique
  productId   String          @map("product_id")
  locationId  String          @map("location_id")
  recordedQty Int             @map("recorded_qty")
  physicalQty Int             @map("physical_qty")
  difference  Int
  reasonId    String?         @map("reason_id")
  reasonName  String?         @map("reason_name")
  notes       String?
  status      OperationStatus @default(draft)
  createdBy   String?         @map("created_by")
  validatedBy String?         @map("validated_by")
  validatedAt DateTime?       @map("validated_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @default(now()) @updatedAt @map("updated_at")

  product  Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  location Location          @relation(fields: [locationId], references: [id], onDelete: Restrict)
  reason   AdjustmentReason? @relation(fields: [reasonId], references: [id], onDelete: SetNull)

  @@map("adjustments")
}

enum MovementType {
  receipt
  delivery
  transfer
  adjustment
}

// Single source of stock-movement history for the whole system. Member 2
// writes rows here (via services/ledgerService.ts); Member 3's
// intelligence layer only ever reads from it. No other ledger/history
// model exists anywhere in the schema.
model StockMovement {
  id                    String       @id @default(uuid())
  operationType         MovementType @map("operation_type")
  reference             String
  productId             String       @map("product_id")
  sku                   String
  quantityChange        Int          @map("quantity_change")
  quantityBefore        Int          @map("quantity_before")
  quantityAfter         Int          @map("quantity_after")
  warehouseId           String?      @map("warehouse_id")
  locationId            String?      @map("location_id")
  sourceLocationId      String?      @map("source_location_id")
  destinationLocationId String?      @map("destination_location_id")
  userEmail             String?      @map("user_email")
  reason                String?
  operationStatus       String       @default("done") @map("operation_status")
  createdAt             DateTime     @default(now()) @map("created_at")

  product             Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse           Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  location            Location?  @relation("MovementLocation", fields: [locationId], references: [id], onDelete: SetNull)
  sourceLocation      Location?  @relation("MovementSource", fields: [sourceLocationId], references: [id], onDelete: SetNull)
  destinationLocation Location?  @relation("MovementDestination", fields: [destinationLocationId], references: [id], onDelete: SetNull)

  @@map("stock_movements")
}

// ============================================================
// INTELLIGENCE (Member 3)
// ============================================================
// Anomaly results and investigations are calculated on demand from
// StockMovement/Stock/ReorderRule — nothing intelligence-specific is
// persisted for them. This model only persists human-review Action
// Center items, with a dedupe key so the same unresolved condition
// (source + type + product + warehouse/location) never creates more
// than one open action.
model IntelligenceAction {
  id                   String    @id @default(uuid())
  type                 String
  priority             String
  title                String
  description          String
  source               String
  status               String    @default("OPEN")
  productId            String?   @map("product_id")
  warehouseId          String?   @map("warehouse_id")
  locationId           String?   @map("location_id")
  referenceId          String?   @map("reference_id")
  recommendedAction    String?   @map("recommended_action")
  conditionFingerprint String    @map("condition_fingerprint")
  dedupeKey            String    @unique @map("dedupe_key")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  resolvedAt           DateTime? @map("resolved_at")

  @@index([status, priority, createdAt])
  @@index([productId, warehouseId])
  @@map("intelligence_actions")
}
