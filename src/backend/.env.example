# StockSense backend — single environment file for the whole unified system.
# No Supabase / Firebase / other BaaS keys — this project uses only
# PostgreSQL via Prisma and its own JWT authentication.

DATABASE_URL=postgresql://user:password@localhost:5432/stocksense

# Required, 32+ random characters — the server refuses to start otherwise.
# Generate one with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
RESET_TOKEN_EXPIRES_IN=10m
OTP_EXPIRY_MINUTES=10

PORT=4000
# Comma-separated list of allowed frontend origins. Required (no default)
# when NODE_ENV=production — the server refuses to start without it rather
# than silently falling back to localhost defaults.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Optional — Member 1's dashboard low-stock threshold (foundation-level
# dashboard, distinct from Member 3's ReorderRule-driven intelligence
# low-stock signal).
LOW_STOCK_THRESHOLD=10

NODE_ENV=development
